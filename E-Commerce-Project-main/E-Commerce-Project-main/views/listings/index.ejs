<% layout("/layouts/boilerplate") %>

<div class="container-fluid px-4 mt-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="fw-bold m-0">
                <% if (searchQuery) { %>
                    Search Results
                <% } else { %>
                    <%= selectedCategory === "All" ? "All Products" : `${selectedCategory} Products` %>
                <% } %>
            </h2>
            <p class="text-muted mb-0 mt-1">
                <% if (searchQuery) { %>
                    <span>Showing results for "<%= searchQuery %>"</span>
                    <% if (selectedCategory !== "All") { %>
                        <span> in <%= selectedCategory %></span>
                    <% } %>
                    <span> · </span>
                <% } %>
                <%= allListings.length %> item<%= allListings.length === 1 ? "" : "s" %> available
            </p>
        </div>

        <% if (currUser && currUser.role === "admin") { %>
            <a href="/listing/new" class="btn btn-dark">
                <i class="fas fa-plus me-2"></i>
                Add Product
            </a>
        <% } %>
    </div>

    <!-- Mobile Category Toggle -->
    <button 
        class="btn filter-toggle w-100 mb-3 d-lg-none"
        data-bs-toggle="collapse"
        data-bs-target="#categoryCollapse"
    >
        ☰ Categories
    </button>

    <div class="row">

        <!-- Sidebar -->
        <div class="col-lg-3 mb-4">
            <div class="collapse d-lg-block category-sticky" id="categoryCollapse">

                <div class="category-card p-3">
                    <h6 class="fw-semibold mb-3">Categories</h6>

                    <ul class="list-unstyled category-list">
                        <% categories.forEach((category) => { %>
                            <li class="<%= category === selectedCategory ? 'active' : '' %>">
                                <a href="<%= category === 'All'
                                    ? (searchQuery ? `/listing?q=${encodeURIComponent(searchQuery)}` : '/listing')
                                    : `/listing?category=${encodeURIComponent(category)}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}` %>">
                                    <%= category %>
                                </a>
                            </li>
                        <% }) %>
                    </ul>
                </div>

            </div>
        </div>

        <!-- Products -->
        <div class="col-lg-9">
            <div class="row g-4">

                <% if (allListings.length === 0) { %>
                    <div class="col-12">
                        <div class="empty-products-state">
                            <h5 class="mb-2">No products found</h5>
                            <p class="text-muted mb-3">
                                Try another search term, switch categories, or browse all products instead.
                            </p>
                            <a href="/listing" class="btn btn-outline-dark">View All Products</a>
                        </div>
                    </div>
                <% } %>

                <% for (let listing of allListings) { %>
                    <div class="col-lg-4 col-md-6">

                        <div class="product-card">

                            <!-- CLICKABLE AREA -->
                            <a href="/listing/<%= listing._id %>" class="product-link">

                                <!-- Image -->
                                <div class="card-image-wrapper">
                                    <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
                                    <!-- <span class="badge-custom">Featured</span> -->
                                </div>

                                <!-- Content -->
                                <div class="card-body-custom">

                                    <small class="category-text"><%= listing.category %></small>

                                    <h6 class="product-title">
                                        <%= listing.title %>
                                    </h6>

                                    <div class="product-price">
                                        ₹ <%= listing.price %>
                                    </div>

                                </div>

                            </a>

                            <!-- BUTTON (OUTSIDE LINK) -->
                            <div class="p-3 pt-0">
                                <form action="/cart/<%= listing._id %>" method="POST">
                                    <input type="hidden" name="quantity" value="1">
                                    <button class="add-btn w-100">
                                        Add to Cart
                                    </button>
                                </form>
                            </div>

                        </div>

                    </div>
                <% } %>

            </div>
        </div>

    </div>
</div>
