<% layout("/layouts/boilerplate") %>

<div class="form-container">
    <div class="form-card">
        <div class="form-header">
            <h2><i class="fas fa-plus-circle"></i> Post Your Product</h2>
            <p>Fill in the details below to list your item</p>
        </div>

        <div class="form-body">
            <form action="/listing" method="post" enctype="multipart/form-data">
                <div class="form-section">
                    <div class="section-title">
                        <i class="fas fa-info-circle"></i>
                        Basic Details
                    </div>

                    <div class="mb-3">
                        <label for="title" class="form-label">
                            Product Title <span class="required">*</span>
                        </label>
                        <input
                            type="text"
                            class="form-control"
                            name="listing[title]"
                            id="title"
                            placeholder="Enter a title for your product"
                            required
                        />
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">
                            Description <span class="required">*</span>
                        </label>
                        <textarea
                            class="form-control"
                            name="listing[description]"
                            id="description"
                            placeholder="Describe your item in detail - condition, features, reason for selling, etc."
                            required
                        ></textarea>
                        <small class="text-muted">
                            Include all relevant details to attract buyers
                        </small>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-title">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                        Pricing
                    </div>

                    <div class="mb-3">
                        <label for="price" class="form-label">
                            Price <span class="required">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fa-solid fa-indian-rupee-sign"></i>
                            </span>
                            <input
                                type="number"
                                class="form-control"
                                name="listing[price]"
                                id="price"
                                placeholder="Enter price in rupees"
                                min="0"
                                required
                            />
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-title">
                        <i class="fas fa-layer-group"></i>
                        Category
                    </div>

                    <div class="mb-3">
                        <label for="category" class="form-label">
                            Category <span class="required">*</span>
                        </label>
                        <select
                            class="form-select"
                            name="listing[category]"
                            id="category"
                            required
                        >
                            <option value="" selected disabled>Select a category</option>
                            <option value="Home Office">Home Office</option>
                            <option value="Furniture">Furniture</option>
                            <option value="Electronics">Electronics</option>
                            <option value="Kitchen">Kitchen</option>
                            <option value="Stationery">Stationery</option>
                        </select>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-title">
                        <i class="fas fa-camera"></i>
                        Photos
                    </div>

                    <div class="mb-3">
                        <label for="image" class="form-label">
                            Upload Image <span class="required">*</span>
                        </label>
                        <input
                            type="file"
                            class="form-control"
                            name="listing[image]"
                            id="image"
                            accept="image/*"
                        />
                        <small class="text-muted">
                            Add clear photo to get more response
                        </small>
                    </div>

                    <div class="image-preview">
                        <div class="text-center">
                            <i class="fas fa-image fa-3x mb-2"></i>
                            <p class="mb-0">Image preview will appear here</p>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="section-title">
                        <i class="fas fa-warehouse"></i>
                        Stock
                    </div>

                    <div class="mb-3">
                        <label for="stock" class="form-label">
                            Stock <span class="required">*</span>
                        </label>
                        <input
                            type="number"
                            class="form-control"
                            name="listing[stock]"
                            id="stock"
                            placeholder="Enter stock quantity"
                            min="0"
                            required
                        />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-8 mb-2 mb-md-0">
                        <button type="submit" class="btn btn-submit">
                            <i class="fas fa-paper-plane me-2"></i>
                            List Your Product
                        </button>
                    </div>
                    <div class="col-md-4">
                        <button
                            type="button"
                            class="btn btn-cancel"
                            onclick="window.history.back()"
                        >
                            Cancel
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="alert alert-info mt-4" role="alert">
        <i class="fas fa-lightbulb me-2"></i>
        <strong>Pro Tip:</strong> Include clear photos and detailed descriptions
        to get 3x more responses.
    </div>
</div>
