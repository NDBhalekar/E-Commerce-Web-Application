<% layout("/layouts/boilerplate") %>

<div class="cart-container">

    <h2 class="cart-title">Shopping Cart</h2>

    <% if (cartItems.length > 0) { %>

    <div class="row g-4">

        <!-- LEFT -->
        <div class="col-lg-8">

            <% cartItems.forEach(item => { %>
                <div class="cart-item">

                    <!-- Image -->
                    <img src="<%= item.product.image.url %>" class="cart-img">

                    <!-- Info -->
                    <div class="cart-info">
                        <h6 class="cart-product-title">
                            <%= item.product.title %>
                        </h6>

                        <p class="cart-category">
                            Home Office
                        </p>

                        <!-- Qty -->
                        <div class="qty-box">
                            <button>Qty.</button>
                            <span><%= item.quantity %></span>
                            
                        </div>
                    </div>

                    <!-- Right -->
                    <div class="cart-right">
                        <div class="cart-price">
                            ₹ <%= item.product.price %>
                        </div>

                        <form method="POST" action="/cart/<%= item._id %>?_method=DELETE">
                            <button class="remove-btn">Remove</button>
                        </form>
                    </div>

                </div>
            <% }) %>

        </div>

        <!-- RIGHT -->
        <div class="col-lg-4">

            <div class="summary-card">

                <h5 class="summary-title">Order Summary</h5>

                <div class="summary-row">
                    <span>Subtotal</span>
                    <span>₹ <%= total %></span>
                </div>

                <div class="summary-row muted">
                    <span>Shipping</span>
                    <span>Free</span>
                </div>

                <hr>

                <div class="summary-total">
                    <span>Total</span>
                    <span>₹ <%= total %></span>
                </div>

                <form action="/payment/checkout" method="POST">
                    <button class="checkout-btn">
                        Proceed to Checkout →
                    </button>
                </form>

                <a href="/listings" class="continue-link">
                    Continue Shopping
                </a>

            </div>
            <div class="summary-card mt-4">

                <h5 class="summary-title">Demo Card Details</h5>
                <div class="summary-row">
                    <span>Card Number</span>
                    <span class="muted">4000 0035 6000 0008</span>
                </div>
                <div class="summary-row">
                    <span>Cardholder Name</span>
                    <span class="muted">Any Name</span>
                </div>
                <div class="summary-row">
                    <span>Expiry Date</span>
                    <span class="muted">Any Future Date</span>
                </div>
                <div class="summary-row">
                    <span>CVC/CVV</span>
                    <span class="muted">Any 3-digit number</span>
                </div>

            </div>

        </div>

    </div>

    <% } else { %>

    <!-- EMPTY -->
    <div class="empty-cart-wrapper">

        <div class="empty-cart">

            <div class="empty-icon">
                <i class="fas fa-shopping-bag"></i>
            </div>

            <h3 class="empty-title">Your cart is empty</h3>

            <p class="empty-text">
                Looks like you haven't added anything to your cart yet.
            </p>

            <a href="/listings" class="primary-btn">
                Start Shopping
            </a>

        </div>

    </div>

    <% } %>

</div>